{
  "name": "gi-pro",
  "displayName": "GI Pro",
  "description": "VS Code extension with GI Pro Git commands and quick workflows.",
  "version": "0.0.1",
  "publisher": "local",
  "engines": {
    "vscode": "^1.92.0"
  },
  "categories": [
    "Source Control"
  ],
  "activationEvents": [
    "onStartupFinished",
    "onCommand:giPro.smartCommit",
    "onCommand:giPro.fetch",
    "onCommand:giPro.pullRebase",
    "onCommand:giPro.push",
    "onCommand:giPro.forcePushLease",
    "onCommand:giPro.amendNoEdit",
    "onCommand:giPro.interactiveRebase",
    "onCommand:giPro.abortGitOperation",
    "onCommand:giPro.stash",
    "onCommand:giPro.stashPop",
    "onCommand:giPro.checkoutBranch",
    "onCommand:giPro.branches",
    "onCommand:giPro.compareFileWithHead",
    "onCommand:giPro.showFileHistory",
    "onCommand:giPro.showLogGraph",
    "onCommand:giPro.openGitLogView",
    "onCommand:giPro.cherryPick",
    "onView:giPro.logView",
    "onView:giPro.branchDiffView"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "giPro.smartCommit",
        "title": "Smart Commit",
        "category": "GI Pro"
      },
      {
        "command": "giPro.fetch",
        "title": "Fetch All",
        "category": "GI Pro"
      },
      {
        "command": "giPro.pullRebase",
        "title": "Pull with Rebase",
        "category": "GI Pro"
      },
      {
        "command": "giPro.push",
        "title": "Push",
        "category": "GI Pro"
      },
      {
        "command": "giPro.forcePushLease",
        "title": "Force Push with Lease",
        "category": "GI Pro"
      },
      {
        "command": "giPro.amendNoEdit",
        "title": "Amend Commit Without Editing Message",
        "category": "GI Pro"
      },
      {
        "command": "giPro.interactiveRebase",
        "title": "Interactive Rebase",
        "category": "GI Pro"
      },
      {
        "command": "giPro.abortGitOperation",
        "title": "Abort",
        "category": "GI Pro"
      },
      {
        "command": "giPro.stash",
        "title": "Stash Changes",
        "category": "GI Pro"
      },
      {
        "command": "giPro.stashPop",
        "title": "Pop Stash",
        "category": "GI Pro"
      },
      {
        "command": "giPro.checkoutBranch",
        "title": "Checkout Branch",
        "category": "GI Pro"
      },
      {
        "command": "giPro.branches",
        "title": "Branches",
        "category": "GI Pro"
      },
      {
        "command": "giPro.compareFileWithHead",
        "title": "Compare File with HEAD",
        "category": "GI Pro"
      },
      {
        "command": "giPro.showFileHistory",
        "title": "Show File History",
        "category": "GI Pro"
      },
      {
        "command": "giPro.showLogGraph",
        "title": "Show Log Graph",
        "category": "GI Pro"
      },
      {
        "command": "giPro.openGitLogView",
        "title": "Open Log View",
        "category": "GI Pro"
      },
      {
        "command": "giPro.cherryPick",
        "title": "Cherry-pick Commit",
        "category": "GI Pro"
      },
      {
        "command": "giPro.branchDiff.refresh",
        "title": "Refresh",
        "category": "GI Pro"
      },
      {
        "command": "giPro.branchDiff.getAll",
        "title": "Get All",
        "category": "GI Pro"
      },
      {
        "command": "giPro.branchDiff.getFile",
        "title": "Get",
        "category": "GI Pro"
      },
      {
        "command": "giPro.branchDiff.openFile",
        "title": "Open Diff",
        "category": "GI Pro"
      }
    ],
    "viewsContainers": {
      "panel": [
        {
          "id": "giProPanel",
          "title": "GI Pro",
          "icon": "media/git-log.svg"
        }
      ]
    },
    "views": {
      "giProPanel": [
        {
          "id": "giPro.logView",
          "name": "Log",
          "type": "webview"
        }
      ],
      "scm": [
        {
          "id": "giPro.branchDiffView",
          "name": "GI Pro Diff"
        }
      ]
    },
    "menus": {
      "editor/context": [
        {
          "command": "giPro.compareFileWithHead",
          "group": "navigation@50",
          "when": "resourceScheme == file"
        },
        {
          "command": "giPro.showFileHistory",
          "group": "navigation@51",
          "when": "resourceScheme == file"
        }
      ],
      "scm/title": [
        {
          "command": "giPro.abortGitOperation",
          "group": "navigation@1",
          "when": "giPro.abortAvailable"
        }
      ],
      "view/title": [
        {
          "command": "giPro.branchDiff.refresh",
          "group": "navigation@1",
          "when": "view == giPro.branchDiffView"
        },
        {
          "command": "giPro.branchDiff.getAll",
          "group": "navigation@2",
          "when": "view == giPro.branchDiffView && giPro.branchDiffAvailable"
        }
      ],
      "view/item/context": [
        {
          "command": "giPro.branchDiff.getFile",
          "group": "inline@1",
          "when": "view == giPro.branchDiffView && viewItem == giProBranchDiffFile"
        }
      ],
      "commandPalette": [
        {
          "command": "giPro.branchDiff.refresh",
          "when": "false"
        },
        {
          "command": "giPro.branchDiff.getAll",
          "when": "false"
        },
        {
          "command": "giPro.branchDiff.getFile",
          "when": "false"
        },
        {
          "command": "giPro.branchDiff.openFile",
          "when": "false"
        }
      ]
    },
    "configuration": {
      "title": "GI Pro",
      "properties": {
        "giPro.terminalName": {
          "type": "string",
          "default": "GI Pro",
          "description": "Terminal name used to run Git commands."
        },
        "giPro.smartCommitPushAfterCommit": {
          "type": "boolean",
          "default": false,
          "description": "Ask whether to push after a smart commit."
        },
        "giPro.inlineBlame.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Show inline Git blame on the active cursor line."
        },
        "giPro.inlineBlame.delayMs": {
          "type": "number",
          "default": 50,
          "minimum": 0,
          "description": "Delay before refreshing inline Git blame after cursor movement."
        }
      }
    }
  },
  "scripts": {
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "lint": "eslint src --ext ts",
    "vscode:prepublish": "npm run compile"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/vscode": "^1.92.0",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "eslint": "^9.0.0",
    "typescript": "^5.5.0"
  }
}
